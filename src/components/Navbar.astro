
<header class="sticky top-0 z-50 border-b border-slate-700/40 bg-midnight/95 backdrop-blur-md">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5"
       aria-label="Main navigation">

    <a href={import.meta.env.BASE_URL} class="text-xl font-bold tracking-tight text-white">
      Fotis<span class="text-ice">.dev</span>
    </a>

    <!-- Desktop navigation -->
    <div class="hidden items-center gap-8 text-sm md:flex">
      <a href="#about" class="text-slate-300 hover:text-ice">About</a>
      <a href="#experience" class="text-slate-300 hover:text-ice">Experience</a>
      <a href="#projects" class="text-slate-300 hover:text-ice">Projects</a>
      <a href="#contact" class="text-ice hover:text-sky-200">Contact</a>
    </div>

    <!-- Mobile menu button -->
    <button
      id="menu-toggle"
      type="button"
      class="rounded-lg border border-slate-700 p-2 text-ice md:hidden"
      aria-label="Toggle navigation menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <svg xmlns="http://www.w3.org/2000/svg"
           width="24" height="24"
           viewBox="0 0 24 24"
           fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round"
           stroke-linejoin="round">
        <path d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </nav>

  <!-- Mobile navigation -->
  <div id="mobile-menu"
       class="hidden border-t border-slate-700/40 bg-midnight px-6 py-5 md:hidden">
    <div class="flex flex-col gap-5 text-sm">
      <a href="#about" class="text-slate-300 hover:text-ice">About</a>
      <a href="#experience" class="text-slate-300 hover:text-ice">Experience</a>
      <a href="#projects" class="text-slate-300 hover:text-ice">Projects</a>
      <a href="#contact" class="text-ice">Contact</a>
    </div>
  </div>
</header>

<script>
  const menuButton = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  function closeMenu() {
    mobileMenu?.classList.add('hidden');
    menuButton?.setAttribute('aria-expanded', 'false');
  }

  menuButton?.addEventListener('click', () => {
    const isClosed = mobileMenu?.classList.toggle('hidden');
    menuButton.setAttribute('aria-expanded', String(!isClosed));
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
</script>
