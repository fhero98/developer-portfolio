
---
const githubUrl = 'https://github.com/fhero98';
const linkedinUrl = 'https://www.linkedin.com/in/fotis-herodotou-568046223';
const upworkUrl = 'https://www.upwork.com/freelancers/~01071acbc59af9346c';
const email = 'herodotouf@gmail.com';
---

<section id="contact" class="scroll-mt-20 border-t border-slate-800 bg-surface/30">
  <div class="mx-auto max-w-6xl px-6 py-24 text-center">

    <p class="mb-4 text-sm font-medium tracking-widest text-ice">
      04 / GET IN TOUCH
    </p>

    <h2 class="text-4xl font-bold tracking-tight text-white md:text-6xl">
      Have a project in mind?
    </h2>

    <p class="mx-auto mt-6 max-w-xl text-lg leading-8 text-muted-blue">
      I'm open to freelance opportunities, backend development
      projects and long-term collaborations.
    </p>

    
    <a
        href={`https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(email)}&su=${encodeURIComponent('Project Inquiry')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-10 inline-flex items-center justify-center rounded-lg bg-ice px-8 py-4 font-medium text-white transition hover:bg-sky-300"
    >
        Get in Touch ↗
    </a>

    <div class="mt-12 flex flex-wrap justify-center gap-6 text-sm">
      <a href={githubUrl} target="_blank" rel="noopener noreferrer"
         class="text-slate-300 hover:text-ice">
        GitHub ↗
      </a>

      <a href={linkedinUrl} target="_blank" rel="noopener noreferrer"
         class="text-slate-300 hover:text-ice">
        LinkedIn ↗
      </a>

      <a href={upworkUrl} target="_blank" rel="noopener noreferrer"
         class="text-slate-300 hover:text-ice">
        Upwork ↗
      </a>
    </div>

  </div>
</section>
